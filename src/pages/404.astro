---
import { ArrowLeft } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout locale="en" pageKey="home" title="Page not found" description="The requested page was not found." noindex>
  <section class="not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The address may be incorrect, or the page may not be published yet.</p>
      <a class="text-link" href="/"><ArrowLeft size={17} />Return home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 58svh; padding: 100px 0; }
  .not-found h1 { margin-bottom: 20px; }
  .not-found p:not(.eyebrow) { color: var(--muted); }
  .not-found .text-link { margin-top: 24px; }
</style>
