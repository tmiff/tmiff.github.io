---
import {
  Award,
  Briefcase,
  Camera,
  Drama,
  Medal,
  Megaphone,
  PenLine,
  Sparkles,
  Star,
  Users,
} from "lucide-astro";
import awards from "../config/awards.json";
import type { Locale } from "../types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const awardIcons: Record<string, typeof Award> = {
  "best-director": Megaphone,
  "best-cinematography": Camera,
  "best-supporting-actress": Star,
  "best-producer": Briefcase,
  "best-writer": PenLine,
  "best-actor": Drama,
  "best-supporting-actor": Users,
  "best-actress": Sparkles,
  "honorable-mention": Medal,
};
---

<div class="award-grid" role="list">
  {awards.categories.map((award, index) => {
    const Icon = awardIcons[award.id] ?? Award;
    return (
      <article class="award-card" role="listitem">
        <div class="award-card__index">{String(index + 1).padStart(2, "0")}</div>
        <Icon size={22} aria-hidden="true" />
        <h3>{award[locale]}</h3>
      </article>
    );
  })}
</div>
