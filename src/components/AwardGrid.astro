---
import {
  Award,
  BookOpen,
  Briefcase,
  Camera,
  Clapperboard,
  Drama,
  Film,
  Megaphone,
  PenLine,
  Sparkles,
  Star,
  Users,
} from "lucide-astro";
import awards from "../config/awards.json";
import type { Locale } from "../types";

interface Props {
  locale: Locale;
  divisionId?: string;
}

const { locale, divisionId } = Astro.props;

const visibleAwards = divisionId
  ? awards.categories.filter((award) => award.divisions.includes(divisionId))
  : awards.categories.filter((award) => award.divisions.length === awards.divisions.length);

const awardIcons: Record<string, typeof Award> = {
  "best-feature-film": Film,
  "best-short-film": Clapperboard,
  "best-documentary": BookOpen,
  "best-director": Megaphone,
  "best-cinematography": Camera,
  "best-supporting-actress": Star,
  "best-producer": Briefcase,
  "best-writer": PenLine,
  "best-actor": Drama,
  "best-supporting-actor": Users,
  "best-actress": Sparkles,
};
---

<div class="award-grid" role="list">
  {visibleAwards.map((award, index) => {
    const Icon = awardIcons[award.id] ?? Award;
    return (
      <article class="award-card" role="listitem">
        <div class="award-card__index">{String(index + 1).padStart(2, "0")}</div>
        <Icon size={22} aria-hidden="true" />
        <h3>{award[locale]}</h3>
      </article>
    );
  })}
</div>
