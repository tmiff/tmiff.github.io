---
import { ArrowRight, BadgeCheck, Building2, CalendarClock, Check, ClipboardCheck, Eye, Film, MonitorPlay } from "lucide-astro";
import AwardGrid from "../AwardGrid.astro";
import EditorialImage from "../EditorialImage.astro";
import HomeHero from "../HomeHero.astro";
import { getPageContent, getSection } from "../../config/content";
import { pagePath } from "../../config/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getPageContent(locale, "home");
const cycle = getSection(locale, "home", "monthly-cycle");
const review = getSection(locale, "home", "review-standard");
const screeningExperience = getSection(locale, "home", "screening-experience");
const online = getSection(locale, "home", "online-program");
const inPerson = getSection(locale, "home", "in-person-program");
const steps = [Film, ClipboardCheck, Eye, BadgeCheck];
---

<BaseLayout locale={locale} pageKey="home" title={content.seoTitle} description={content.intro}>
  <HomeHero locale={locale} />

  <section class="band band--light" aria-labelledby="cycle-title" data-reveal>
    <div class="container home-production-split">
      <div class="home-production-split__media">
        <EditorialImage id="home-production-craft" locale={locale} variant="split" />
      </div>
      <div class="home-production-split__copy">
        <h2 id="cycle-title">{cycle.title}</h2>
        <p>{cycle.body[0]}</p>
      </div>
    </div>
    <div class="container step-grid">
      {cycle.items.map((item, index) => {
        const Icon = steps[index];
        return (
          <article class="step-card">
            <span class="step-card__number">{String(index + 1).padStart(2, "0")}</span>
            <Icon size={24} aria-hidden="true" />
            <h3>{item}</h3>
          </article>
        );
      })}
    </div>
  </section>

  <section class="fact-strip" aria-label={locale === "ja" ? "応募部門" : "Submission divisions"} data-reveal>
    <div class="container fact-strip__inner">
      <div><strong>{locale === "ja" ? "短編" : "Short Film"}</strong><span>{locale === "ja" ? "35分以下" : "35 min or less"}</span></div>
      <div><strong>{locale === "ja" ? "長編" : "Feature Film"}</strong><span>{locale === "ja" ? "35分超" : "More than 35 min"}</span></div>
    </div>
  </section>

  <section class="band" aria-labelledby="review-title" data-reveal>
    <div class="container split-section">
      <div class="home-review-block">
        <h2 id="review-title" class="home-promoted-heading">{review.title}</h2>
        <div id={review.id} class="home-review-content">
          {review.body.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="check-list">
            {review.items.map((item) => <li><Check size={17} aria-hidden="true" /><span>{item}</span></li>)}
          </ul>
        </div>
        <a class="text-link" href={pagePath(locale, "selection")}>
          {locale === "ja" ? "全工程を確認" : "Review the full process"}<ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
      <div class="process-summary" aria-hidden="true">
        <div><ClipboardCheck size={28} /><span>{locale === "ja" ? "適格性" : "Eligibility"}</span></div>
        <span class="process-summary__line"></span>
        <div><Eye size={28} /><span>{locale === "ja" ? "作品評価" : "Review"}</span></div>
        <span class="process-summary__line"></span>
        <div><BadgeCheck size={28} /><span>{locale === "ja" ? "結果確定" : "Decision"}</span></div>
      </div>
    </div>
  </section>

  <section class="home-screening-feature" aria-labelledby="screening-experience-title" data-reveal>
    <EditorialImage id="home-screening" locale={locale} variant="band" />
    <div class="home-screening-feature__shade" aria-hidden="true"></div>
    <div class="container home-screening-feature__content">
      <div>
        <h2 id="screening-experience-title" class="home-screening-feature__title">Film Review</h2>
        <p>{screeningExperience.body[0]}</p>
      </div>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="awards-title">
    <div class="home-awards-content" data-reveal>
      <div class="home-awards-feature">
        <EditorialImage id="home-awards-craft" locale={locale} variant="band" />
        <div class="home-awards-feature__shade" aria-hidden="true"></div>
        <div class="container home-awards-feature__copy">
          <h2 id="awards-title" class="home-promoted-heading home-promoted-heading--light">{locale === "ja" ? "受賞項目" : "Award Categories"}</h2>
          <p>{locale === "ja" ? "短編部門と長編部門に同じ賞構成を適用します。" : "The short and feature divisions use the same award structure."}</p>
        </div>
      </div>
      <div class="container"><AwardGrid locale={locale} /></div>
      <div class="container section-link-row">
        <a class="text-link text-link--light" href={pagePath(locale, "awards")}>
          {locale === "ja" ? "賞と証書を見る" : "View awards and certificates"}<ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="band band--light" data-reveal>
    <div class="container">
      <div class="format-grid" aria-label={locale === "ja" ? "オンラインとオフラインの開催形式" : "Online and in-person formats"}>
        <article class="format-grid__online">
          <div class="format-grid__media"><EditorialImage id="home-online-experience" locale={locale} variant="split" /></div>
          <div class="format-grid__shade" aria-hidden="true"></div>
          <div class="format-grid__copy format-grid__copy--light">
            <span class="format-grid__number" aria-hidden="true">01</span>
            <MonitorPlay size={28} aria-hidden="true" />
            <p class="eyebrow eyebrow--light">Online</p>
            <h2>{online.title}</h2>
            <p>{online.body[0]}</p>
          </div>
        </article>
        <article class="format-grid__in-person">
          <div class="format-grid__media"><EditorialImage id="home-in-person" locale={locale} variant="split" /></div>
          <div class="format-grid__shade" aria-hidden="true"></div>
          <div class="format-grid__copy format-grid__copy--light">
            <span class="format-grid__number" aria-hidden="true">02</span>
            <Building2 size={28} aria-hidden="true" />
            <p class="eyebrow eyebrow--light">In Person</p>
            <h2>{inPerson.title}</h2>
            <p>{inPerson.body[0]}</p>
          </div>
        </article>
      </div>
      <div class="final-cta">
        <CalendarClock size={26} aria-hidden="true" />
        <div>
          <h2>{locale === "ja" ? "応募前に確認" : "Before Submitting"}</h2>
          <p class="final-cta__description">{locale === "ja" ? "規約と月次締切の確認は右側の応募案内から" : "Review the rules and monthly deadline through the submission guide on the right."}</p>
        </div>
        <a class="button" href={pagePath(locale, "submit")}>{locale === "ja" ? "応募案内" : "Submission Guide"}<ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <script>
    const revealItems = document.querySelectorAll<HTMLElement>('body[data-page="home"] [data-reveal]');
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      document.documentElement.classList.add("reveal-enabled");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -7%" },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
