---
import { CalendarX2 } from "lucide-astro";
import { getPageContent } from "../../config/content";
import { navigationLabels, pagePath } from "../../config/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import records from "../../content/winners/records.json";
import type { Locale, WinnerRecord } from "../../types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getPageContent(locale, "winners");
// Each published cycle is one edition of the festival's results, numbered from the oldest (1st). The
// list shows the newest edition first, so a new month is added at the top and the 1st stays at the bottom.
const winners = [...(records as WinnerRecord[])]
  .sort((a, b) => a.cycleId.localeCompare(b.cycleId))
  .map((cycle, index) => ({ cycle, edition: index + 1 }))
  .reverse();
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const cycleMonth = (cycleId: string) => {
  const [year, month] = cycleId.split("-").map(Number);
  return locale === "ja" ? `${year}年${month}月` : `${monthNames[month - 1]} ${year}`;
};
const ordinal = (n: number) => {
  const tens = n % 100;
  const suffix = tens >= 11 && tens <= 13 ? "th" : ({ 1: "st", 2: "nd", 3: "rd" } as Record<number, string>)[n % 10] ?? "th";
  return `${n}${suffix}`;
};
const editionTitle = (edition: number) => (locale === "ja" ? `第${edition}回 受賞結果` : `${ordinal(edition)} Award Results`);
---

<BaseLayout locale={locale} pageKey="winners" title={content.seoTitle} description={content.intro}>
  <header class="winners-hero">
    <div class="container">
      <h1>{navigationLabels[locale].winners ?? content.title}</h1>
    </div>
  </header>
  <section class="band band--light">
    <div class="container winners-index">
      {winners.length === 0 ? (
        <div class="empty-state">
          <CalendarX2 size={34} aria-hidden="true" />
          <h2>{locale === "ja" ? "公開済みの受賞結果はありません。" : "No award results have been published."}</h2>
          <p>{locale === "ja" ? "受賞結果は発表後、このページに掲載します。" : "Award results will appear here after they are announced."}</p>
        </div>
      ) : (
        <ol class="cycle-list">
          {winners.map(({ cycle, edition }) => (
            <li>
              <a class="cycle-link" href={`${pagePath(locale, "winners")}${cycle.cycleId}/`}>
                <span>{cycleMonth(cycle.cycleId)}</span>
                <h2>{editionTitle(edition)}</h2>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>
