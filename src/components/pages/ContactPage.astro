---
import PageHero from "../PageHero.astro";
import SectionBlock from "../SectionBlock.astro";
import { getPageContent } from "../../config/content";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getPageContent(locale, "contact");
const configured = Boolean(siteConfig.contactEndpoint && siteConfig.turnstileSiteKey);
---

<BaseLayout locale={locale} pageKey="contact" title={content.seoTitle} description={content.intro}>
  <PageHero eyebrow={content.eyebrow} title={content.title} intro={content.intro} label={getPageContent("en", "contact").eyebrow} />
  <section class="band band--light">
    <div class="container contact-layout">
      <div>
        <p class="eyebrow">{locale === "ja" ? "問い合わせフォーム" : "Inquiry form"}</p>
        <h2>{locale === "ja" ? "必要な情報だけを送信してください。" : "Send only the information required to answer the question."}</h2>
      </div>
      <form
        class="contact-form"
        method={configured ? "post" : undefined}
        action={configured ? siteConfig.contactEndpoint : undefined}
        target={configured ? "contact-response" : undefined}
        data-contact-form
        data-contact-ready={configured ? "true" : "false"}
      >
        <input type="hidden" name="locale" value={locale} />
        <input type="hidden" name="formVersion" value="2" />
        <label class="honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="form-row">
          <label>{locale === "ja" ? "氏名" : "Name"}<input type="text" name="name" autocomplete="name" maxlength="120" required /></label>
          <label>{locale === "ja" ? "メールアドレス" : "Email"}<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
        </div>
        <div class="form-row">
          <label>{locale === "ja" ? "会社・団体名（任意）" : "Company / organization (optional)"}<input type="text" name="organization" autocomplete="organization" maxlength="160" /></label>
          <label>{locale === "ja" ? "国・地域（任意）" : "Country / region (optional)"}<input type="text" name="country" autocomplete="country-name" maxlength="120" /></label>
        </div>
        <div class="form-row">
          <label>{locale === "ja" ? "問い合わせ種別" : "Topic"}
            <select name="topic" required>
              <option value="">{locale === "ja" ? "選択してください" : "Select a topic"}</option>
              <option value="submission">{locale === "ja" ? "応募" : "Submission"}</option>
              <option value="payment">{locale === "ja" ? "支払い" : "Payment"}</option>
              <option value="result">{locale === "ja" ? "選考結果" : "Result"}</option>
              <option value="certificate">{locale === "ja" ? "証書" : "Certificate"}</option>
              <option value="accessibility">{locale === "ja" ? "アクセシビリティ" : "Accessibility"}</option>
              <option value="other">{locale === "ja" ? "その他" : "Other"}</option>
            </select>
          </label>
          <label>{locale === "ja" ? "FilmFreeway応募ID（任意）" : "FilmFreeway submission ID (optional)"}<input type="text" name="submissionId" maxlength="80" /></label>
        </div>
        <label>{locale === "ja" ? "件名" : "Subject"}<input type="text" name="subject" maxlength="180" required /></label>
        <label>{locale === "ja" ? "本文" : "Message"}<textarea name="message" rows="8" minlength="10" maxlength="5000" required></textarea></label>
        <label class="consent-row"><input type="checkbox" name="privacyAccepted" value="true" required /><span>{locale === "ja" ? "問い合わせ対応のために情報が処理されることを確認しました。" : "I understand that this information will be processed to handle my inquiry."}</span></label>
        <div class="cf-turnstile" data-sitekey={siteConfig.turnstileSiteKey} data-action="contact"></div>
        <button class="button" type="submit" disabled={!configured}>{locale === "ja" ? "問い合わせを送信" : "Send inquiry"}</button>
        <p class="form-status" data-form-status aria-live="polite"></p>
      </form>
      {configured && <iframe class="response-frame" name="contact-response" title={locale === "ja" ? "問い合わせ送信結果" : "Inquiry response"} data-contact-frame></iframe>}
    </div>
  </section>
  <div class="container content-sections">
    {content.sections.map((section, index) => <SectionBlock section={section} index={index} />)}
  </div>
  {configured && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>

<script>
  const form = document.querySelector("[data-contact-form]");
  const frame = document.querySelector("[data-contact-frame]");
  const status = document.querySelector("[data-form-status]");
  const submit = form?.querySelector("button[type='submit']");
  const ready = form?.getAttribute("data-contact-ready") === "true";

  form?.addEventListener("submit", (event) => {
    if (!ready) {
      event.preventDefault();
      return;
    }
    if (status) status.textContent = document.documentElement.lang === "ja" ? "送信中です。" : "Sending...";
    if (submit instanceof HTMLButtonElement) submit.disabled = true;
  });

  window.addEventListener("message", (event) => {
    const allowed = event.origin === "https://script.google.com" || event.origin.endsWith(".googleusercontent.com");
    if (!allowed || !(frame instanceof HTMLIFrameElement) || event.source !== frame.contentWindow) return;
    if (!event.data || event.data.type !== "festival-contact-result") return;
    if (status) status.textContent = event.data.message;
    if (event.data.ok && form instanceof HTMLFormElement) form.reset();
    if (submit instanceof HTMLButtonElement) submit.disabled = false;
    const turnstileWindow = window as typeof window & { turnstile?: { reset?: () => void } };
    turnstileWindow.turnstile?.reset?.();
  });
</script>
