---
import { ArrowRight, Clock3, ExternalLink } from "lucide-astro";
import PageHero from "../PageHero.astro";
import SectionBlock from "../SectionBlock.astro";
import { getPageContent } from "../../config/content";
import { pagePath } from "../../config/paths";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getPageContent(locale, "submit");
---

<BaseLayout locale={locale} pageKey="submit" title={content.seoTitle} description={content.intro}>
  <PageHero eyebrow={content.eyebrow} title={content.title} intro={content.intro} label={getPageContent("en", "submit").eyebrow} />

  <section class="band band--light">
    <div class="container division-grid">
      <article class="division-card">
        <Clock3 size={30} aria-hidden="true" />
        <p class="eyebrow">{locale === "ja" ? "短編部門" : "Short film"}</p>
        <h2>{locale === "ja" ? "35 minまで" : "Up to 35 min"}</h2>
        <p>{locale === "ja" ? "クレジットを含む" : "Including credits"}</p>
      </article>
      <article class="division-card">
        <Clock3 size={30} aria-hidden="true" />
        <p class="eyebrow">{locale === "ja" ? "長編部門" : "Feature film"}</p>
        <h2>{locale === "ja" ? "35 min超" : "Over 35 min"}</h2>
        <p>{locale === "ja" ? "クレジットを含む" : "Including credits"}</p>
      </article>
    </div>
  </section>

  <div class="container content-sections">
    {content.sections.map((section, index) => <SectionBlock section={section} index={index} />)}
  </div>

  <section class="submission-panel">
    <div class="container submission-panel__inner">
      <p class="eyebrow eyebrow--light">FilmFreeway</p>
      {siteConfig.filmFreewayUrl ? (
        <a class="button button--submission" href={siteConfig.filmFreewayUrl} rel="external">
          {locale === "ja" ? "応募はこちら" : "Submit Here"}<ExternalLink size={20} aria-hidden="true" />
        </a>
      ) : (
        <span class="button button--disabled button--submission button--submission-disabled" aria-disabled="true">{locale === "ja" ? "応募はこちら" : "Submit Here"}</span>
      )}
      <p class="submission-panel__note">{locale === "ja" ? "※問い合わせフォームやメールには作品ファイルを添付しないでください。" : "* Do not attach film files to inquiry forms or email."}</p>
    </div>
  </section>

  <div class="container adjacent-link">
    <a class="text-link" href={pagePath(locale, "rules")}>{locale === "ja" ? "応募規約を読む" : "Read the submission rules"}<ArrowRight size={17} aria-hidden="true" /></a>
  </div>
</BaseLayout>
