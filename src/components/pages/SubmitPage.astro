---
import { ArrowRight, ExternalLink, Film, Timer } from "lucide-astro";
import PageHero from "../PageHero.astro";
import SectionBlock from "../SectionBlock.astro";
import StatusCallout from "../StatusCallout.astro";
import { getPageContent } from "../../config/content";
import { pagePath } from "../../config/paths";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../types";

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getPageContent(locale, "submit");
---

<BaseLayout locale={locale} pageKey="submit" title={content.seoTitle} description={content.intro}>
  <PageHero eyebrow={content.eyebrow} title={content.title} intro={content.intro} />
  <div class="container callout-wrap">
    <StatusCallout
      tone={siteConfig.filmFreewayUrl ? "safe" : "warning"}
      title={siteConfig.filmFreewayUrl ? (locale === "ja" ? "応募受付中" : "Submissions open") : (locale === "ja" ? "応募受付は未開始です" : "Submissions are not open")}
      body={siteConfig.filmFreewayUrl ? (locale === "ja" ? "以下の専用FilmFreewayページから応募してください。" : "Use the dedicated FilmFreeway listing below.") : (locale === "ja" ? "FilmFreeway URL、応募料、返金規定が確定するまで応募ボタンは無効です。" : "The button remains disabled until the FilmFreeway URL, fee, and refund terms are approved.")}
    />
  </div>

  <section class="band band--light">
    <div class="container division-grid">
      <article class="division-card">
        <Film size={25} aria-hidden="true" />
        <p class="eyebrow">{locale === "ja" ? "短編部門" : "Short film"}</p>
        <h2>≤ 2,100 sec</h2>
        <p>{locale === "ja" ? "35分00秒以下（クレジットを含む）" : "35:00 or less, including credits"}</p>
      </article>
      <article class="division-card">
        <Timer size={25} aria-hidden="true" />
        <p class="eyebrow">{locale === "ja" ? "長編部門" : "Feature film"}</p>
        <h2>&gt; 2,100 sec</h2>
        <p>{locale === "ja" ? "35分00秒を超える作品（クレジットを含む）" : "Longer than 35:00, including credits"}</p>
      </article>
    </div>
  </section>

  <div class="container content-sections">
    {content.sections.map((section, index) => <SectionBlock section={section} index={index} />)}
  </div>

  <section class="submission-panel">
    <div class="container submission-panel__inner">
      <div>
        <p class="eyebrow eyebrow--light">FilmFreeway</p>
        <h2>{locale === "ja" ? "応募内容は外部の専用ページで送信します。" : "Entries are submitted through the dedicated external listing."}</h2>
        <p>{locale === "ja" ? "問い合わせフォームやメールには作品ファイルを添付しないでください。" : "Do not attach film files to inquiry forms or ordinary email."}</p>
      </div>
      {siteConfig.filmFreewayUrl ? (
        <a class="button" href={siteConfig.filmFreewayUrl} rel="external">
          {locale === "ja" ? "FilmFreewayを開く" : "Open FilmFreeway"}<ExternalLink size={18} aria-hidden="true" />
        </a>
      ) : (
        <span class="button button--disabled button--on-dark" aria-disabled="true">{locale === "ja" ? "URL未設定" : "URL not configured"}</span>
      )}
    </div>
  </section>

  <div class="container adjacent-link">
    <a class="text-link" href={pagePath(locale, "rules")}>{locale === "ja" ? "応募規約を読む" : "Read the submission rules"}<ArrowRight size={17} aria-hidden="true" /></a>
  </div>
</BaseLayout>
