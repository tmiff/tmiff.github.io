---
import { ArrowRight, CalendarDays } from "lucide-astro";
import { getImageSlot } from "../config/images";
import { pagePath } from "../config/paths";
import { festivalName, siteConfig } from "../config/site";
import type { Locale } from "../types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const slot = getImageSlot("home-hero");
const generated = slot.rightsStatus !== "pending-generation";
const dateLabel = locale === "ja" ? "毎月20日 23:59締切" : "Monthly deadline: 20th at 23:59";
const hasSubmitUrl = Boolean(siteConfig.filmFreewayUrl);
const submissionsOpen = siteConfig.releasePhase === "submissions-open" && hasSubmitUrl;
const display = slot.display;
const heroStyle = [
  `--hero-image-position: ${display?.position ?? "50% 50%"}`,
  `--hero-image-position-mobile: ${display?.mobilePosition ?? display?.position ?? "50% 50%"}`,
  `--hero-image-scale: ${display?.scale ?? 1}`,
  `--hero-image-scale-mobile: ${display?.mobileScale ?? display?.scale ?? 1}`,
].join("; ");
---

<section class:list={["home-hero", generated ? "home-hero--ready" : "home-hero--placeholder"]} style={heroStyle} data-image-slot={slot.id}>
  <div class="home-hero__media" aria-hidden="true">
    {generated && <img src={slot.file} width={slot.width} height={slot.height} alt="" decoding="async" fetchpriority="high" />}
  </div>
  <div class="home-hero__overlay" aria-hidden="true"></div>
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <h1>{festivalName(locale)}</h1>
      <div class="button-row">
        <a class="button button--hero-secondary" href={pagePath(locale, "selection")}>
          {locale === "ja" ? "選考プロセスを見る" : "View the selection process"}
        </a>
        {submissionsOpen ? (
          <a class="button button--hero-submit" href={siteConfig.filmFreewayUrl} rel="external">
            {locale === "ja" ? "応募はこちらから" : "Submit Here"}
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        ) : (
          <span class="button button--hero-submit button--disabled" aria-disabled="true">
            {locale === "ja" ? "応募準備中" : "Submissions opening soon"}
          </span>
        )}
      </div>
    </div>
    <div class="home-hero__meta">
      <CalendarDays size={20} aria-hidden="true" />
      <span>{dateLabel}</span>
      {!generated && <span class="home-hero__slot">{slot.width} × {slot.height} / {slot.ratio}</span>}
    </div>
  </div>
</section>
