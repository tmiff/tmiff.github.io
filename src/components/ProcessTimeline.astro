---
import { BadgeCheck, ClipboardCheck, Eye, FileUp, Radio } from "lucide-astro";
import type { ContentSection, Locale } from "../types";

interface Props {
  locale: Locale;
  sections: ContentSection[];
}

const { locale, sections } = Astro.props;
const icons = [FileUp, ClipboardCheck, Eye, BadgeCheck, Radio];
const dates = locale === "ja"
  ? ["毎月20日〜翌々月20日", "最終締切後", "翌々月末日通知", "会場開催日まで", "翌月15日 会場で発表"]
  : ["20th to the 20th two months later", "After the final deadline", "Notice on that month-end", "Before the event day", "Announced at the event on the 15th"];
---

<ol class="process-timeline">
  {sections.map((section, index) => {
    const Icon = icons[index];
    return (
      <li id={section.id}>
        <div class="process-timeline__marker"><Icon size={21} aria-hidden="true" /></div>
        {/* The cell stays even when a step has no date: the row is a three-column grid, and a
            missing cell pushes the step's text into the narrow date column. */}
        <div class="process-timeline__date">{dates[index]}</div>
        <div class="process-timeline__content">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </li>
    );
  })}
</ol>
