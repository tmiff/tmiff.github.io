{
  "name": "film-festival-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "npm run validate:content && astro check",
    "build": "npm run check && astro build && node scripts/check-built-site.mjs",
    "build:release": "node scripts/validate-release.mjs && PUBLIC_RELEASE=true npm run build",
    "preview": "astro preview",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "generate:laurels": "node scripts/generate-laurels.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.9",
    "lucide-astro": "^0.556.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "sharp": "latest",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
